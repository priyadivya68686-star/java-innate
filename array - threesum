import java.util.Scanner;
class Main {
    Scanner sc = new Scanner(System.in);
   

    static boolean threeSum(int[] arr, int target){
        int n = arr.length;

        for (int i = 0; i < n; i++) {
          
            
            for (int j = i+1;j<n;j++) {
                for(int k=j+1;k<n;k++){
              
               
                if (arr[i] + arr[j] + arr[k] == target) {
                    return true;
                }
            }
        }
      
        }  
        return false;
    
    }
